# Ferri — secrets
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Admin panel token — minimum 32 characters.
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=

# SMTP relay password.
# The username and host are configured in config.yaml.
SMTP_PASSWORD=

# Litestream S3 backup credentials (optional).
# Leave blank if you are not using S3 replication.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
